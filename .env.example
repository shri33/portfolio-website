# Environment Variables Template
# Copy this file to .env.local and fill in your values

# OpenAI API Key (optional - for generative project features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Analytics ID (optional - for analytics)
# Get your GA4 measurement ID from Google Analytics
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# Contact Form Service (optional - for contact form submissions)
# Example: Formspree, Netlify Forms, or custom backend
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=your_contact_form_endpoint_here

# Site URL (for sitemap and SEO)
NEXT_PUBLIC_SITE_URL=https://shri33.github.io
