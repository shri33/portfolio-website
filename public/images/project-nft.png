<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="nftGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#EC4899;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#8B5CF6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3B82F6;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cardGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFD700;stop-opacity:0.8" />
      <stop offset="100%" style="stop-color:#FFA500;stop-opacity:0.8" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#nftGrad)"/>
  
  <!-- NFT Card frame -->
  <g transform="translate(400, 300)">
    <rect x="-150" y="-180" width="300" height="360" fill="white" opacity="0.15" rx="15" stroke="white" stroke-width="3"/>
    
    <!-- Image placeholder -->
    <rect x="-130" y="-160" width="260" height="200" fill="url(#cardGlow)" rx="10"/>
    
    <!-- Gallery grid pattern -->
    <rect x="-120" y="-150" width="80" height="80" fill="white" opacity="0.3" rx="5"/>
    <rect x="-30" y="-150" width="80" height="80" fill="white" opacity="0.25" rx="5"/>
    <rect x="60" y="-150" width="80" height="80" fill="white" opacity="0.2" rx="5"/>
    <rect x="-120" y="-60" width="80" height="80" fill="white" opacity="0.25" rx="5"/>
    <rect x="-30" y="-60" width="80" height="80" fill="white" opacity="0.3" rx="5"/>
    <rect x="60" y="-60" width="80" height="80" fill="white" opacity="0.25" rx="5"/>
    
    <!-- Card details -->
    <rect x="-130" y="60" width="200" height="15" fill="white" opacity="0.6" rx="5"/>
    <rect x="-130" y="85" width="150" height="12" fill="white" opacity="0.4" rx="5"/>
    
    <!-- Ethereum symbol -->
    <g transform="translate(90, 90)">
      <polygon points="0,-15 -10,0 0,5 10,0" fill="white" opacity="0.9"/>
      <polygon points="0,7 -10,-8 0,-3 10,-8" fill="white" opacity="0.7"/>
    </g>
    
    <!-- Price tag -->
    <text x="110" y="95" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="white">ETH</text>
  </g>
  
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="white" text-anchor="middle">NFT Marketing</text>
  <text x="400" y="555" font-family="Arial, sans-serif" font-size="18" fill="white" text-anchor="middle" opacity="0.9">Web3 • Digital Collectibles</text>
</svg>
